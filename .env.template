# Hallenbuch — Betriebseinstellungen.
# Diese Datei kopieren nach .env und ausfuellen. .env gehoert NICHT ins Repo.

# PFLICHT. Unterschreibt die Sitzungs-Kekse. Ohne diesen Wert startet der
# Dienst nicht, weil sich sonst Anmeldungen faelschen liessen.
# Einmal erzeugen, dann nie wieder aendern, sonst werden alle abgemeldet:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
HALLENBUCH_GEHEIMNIS=

# Port, auf dem der Dienst lauscht. Davor gehoert ein Caddy oder nginx mit TLS.
HALLENBUCH_PORT=8080

# Pfad der Datenbank. Standard: betrieb/hallenbuch.db neben der Anwendung.
# HALLENBUCH_DB=/opt/hallenbuch/betrieb/hallenbuch.db

# Lexware Office, Tarif XL. Solange leer, laeuft alles im Probebetrieb:
# Belege werden vollstaendig aufgebaut, aber nicht ausgestellt.
# Der Zugang gehoert dem Betrieb, nicht Fynaxa.
LEXWARE_SCHLUESSEL=
